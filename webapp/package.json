{
  "name": "amail-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/../tmp/playwright-browsers\" playwright test",
